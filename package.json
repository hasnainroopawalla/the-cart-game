{
  "name": "cart-game",
  "version": "1.0.1",
  "description": "🛒 Grocery puzzle game — build a cart that satisfies a list of competing rules",
  "homepage": "https://hasnainroopawalla.github.io/the-cart-game",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "predeploy": "yarn build",
    "deploy": "gh-pages -d build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "knip": "knip"
  },
  "keywords": [
    "game",
    "browser-game",
    "puzzle",
    "puzzle-game",
    "logic-game",
    "constraint-satisfaction",
    "grocery",
    "shopping-list",
    "react",
    "typescript",
    "vite",
    "tailwindcss"
  ],
  "author": "Hasnain Roopawalla",
  "license": "MIT",
  "dependencies": {
    "classnames": "^2.5.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gh-pages": "^6.3.0",
    "jsdom": "^29.1.1",
    "knip": "^6.25.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
